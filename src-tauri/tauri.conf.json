{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskNote",
  "version": "1.0.0",
  "identifier": "com.notes.sticky",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskNote",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 DeskNote",
    "publisher": "DeskNote",
    "category": "Productivity",
    "shortDescription": "轻量级桌面便签应用",
    "longDescription": "DeskNote 是一款极致轻量的桌面便签应用，支持将便签贴在屏幕上作为虚拟便利贴。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
